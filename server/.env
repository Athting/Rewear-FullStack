# Server Configurations
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local/Mock MongoDB database connection string (use local fallback if not installed)
MONGODB_URI=mongodb://localhost:27017/rewear

# JWT signing tokens
JWT_SECRET=jwt_secret_token_signature_key_here_123
JWT_REFRESH_SECRET=jwt_refresh_token_signature_key_here_456

# Cloudinary credentials (leave blank for local mockups fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API key (leave blank for local mockups fallback)
GEMINI_API_KEY=

# Nodemailer credentials (leave blank for local mockups fallback)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
