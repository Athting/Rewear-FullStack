# Server Configurations
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB database connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rewear?retryWrites=true&w=majority

# JWT signing tokens
JWT_SECRET=jwt_secret_token_signature_key_here_123
JWT_REFRESH_SECRET=jwt_refresh_token_signature_key_here_456

# Cloudinary credentials (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API key (for vision tags & chat suggestions)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Nodemailer credentials (SMTP configuration for emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
